# Configuration template for the CEDAR risk-scoring tool -- PRODUCTION values.
# Copy to .env and fill in the empty fields. Never share or commit the filled-in .env.

# --- Knowledge graph (HTTP gateway) ---
GRAPH_ENDPOINT=https://kg-{pilot}.cedar-heu-project.eu/neo4j/query
GRAPH_API_KEY=
# or one key per pilot: GRAPH_API_KEY_IT=, GRAPH_API_KEY_SL=

# --- Pilots and topics ---
PILOTS=it,sl
KAFKA_REQUEST_TOPICS=it_analyse,sl_analyse
KAFKA_RESULTS_TOPICS=it_results_available,sl_results_available
KAFKA_GROUP_ID=upm-raphtory

# --- Responses saved on disk ---
# Each response is saved as JSON in this folder before it is published:
#   <OUTPUT_DIR>/<pilot>_latest.json, <OUTPUT_DIR>/<pilot>/<time>_<requestID>.json
# Start the path with ./ or / (Docker mounts it). Leave empty: not saved, only published.
OUTPUT_DIR=./outputs

# --- Logger ---
LOG_FILE=logs/cedar.log
LOG_LEVEL=INFO
# keep only the last N days of log files (unset: keep every day)
LOG_BACKUPS=30

# --- Kafka: the variables of the CEDAR production template ---
# (secure-kafka/README.md). The cluster uses SASL_SSL: TLS with a client
# certificate + SASL PLAIN; it is selected automatically from the files below.
KAFKA_BOOTSTRAP_SERVERS=kafka.cedar-heu-project.eu:8004

# The folder extracted from secure-kafka/users/upm.7z, holding
# kafka-cedar-ca-1.crt, upm.certificate.pem, upm.key and cred.txt.
# Keep it OUTSIDE the repository; start the path with ./ or / (Docker mounts it).
KAFKA_CREDENTIALS_DIR=
# Optional: one credential file at a time. Normally leave these three EMPTY:
# the module then takes the files from KAFKA_CREDENTIALS_DIR, under the names
# the archive gives them:
#   KAFKA_CA_FILE    -> <KAFKA_CREDENTIALS_DIR>/kafka-cedar-ca-1.crt
#   KAFKA_CERT_FILE  -> <KAFKA_CREDENTIALS_DIR>/<KAFKA_SASL_USERNAME>.certificate.pem
#   KAFKA_KEY_FILE   -> <KAFKA_CREDENTIALS_DIR>/<KAFKA_SASL_USERNAME>.key
# Set one only if that file was renamed or kept in another folder; it replaces
# just that file (a relative path is relative to this .env file).
# Docker ignores them: the container only sees the mounted KAFKA_CREDENTIALS_DIR,
# so with Docker keep the three files there under their archive names.
KAFKA_CA_FILE=
KAFKA_CERT_FILE=
KAFKA_KEY_FILE=

# --- Secrets: from cred.txt, one value per line ---
# line 1: private key passphrase
KAFKA_KEY_PASSWORD=
# line 2: SASL username
KAFKA_SASL_USERNAME=
# line 3: SASL password
KAFKA_SASL_PASSWORD=

